{
  "name": "vault66-crt-effect",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./vue": {
      "import": { "types": "./dist/vue/index.d.ts", "default": "./dist/vue.js" },
      "require": { "types": "./dist/vue/index.d.cts", "default": "./dist/vue.cjs" }
    },
    "./element": {
      "import": { "types": "./dist/element/index.d.ts", "default": "./dist/element.js" },
      "require": { "types": "./dist/element/index.d.cts", "default": "./dist/element.cjs" }
    },
    "./core": {
      "import": { "types": "./dist/core/index.d.ts", "default": "./dist/core.js" },
      "require": { "types": "./dist/core/index.d.cts", "default": "./dist/core.cjs" }
    },
    "./style.css": "./dist/vault66-crt-effect.css",
    "./dist/vault66-crt-effect.css": "./dist/vault66-crt-effect.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/element.js",
    "**/element.cjs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "description": "A customizable CRT (retro monitor) visual effect for React, Vue, and Web Components",
  "keywords": [
    "react",
    "vue",
    "angular",
    "svelte",
    "web-component",
    "custom-element",
    "crt",
    "crt-effect",
    "scanlines",
    "terminal",
    "retro",
    "retro-ui",
    "vintage",
    "glitch",
    "vaporwave",
    "synthwave",
    "cyberpunk",
    "fallout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mdombrov-33/vault66-crt-effect.git"
  },
  "author": "Maksym Dombrov",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-cjs-types.mjs",
    "dev:react": "vite examples/react",
    "dev:vue": "vite examples/vue",
    "dev:vanilla": "vite examples/vanilla",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vue": "^3.5.0"
  }
}
